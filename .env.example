# ── PostgreSQL ──
POSTGRES_USER=UserService
POSTGRES_PASSWORD=UserService
POSTGRES_DB=UserDb

# ── pgAdmin ──
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=SuperSecret123

# ── RabbitMQ ──
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ── MailPit ──
MP_MAX_MESSAGES=500
MP_DATABASE=/data/mailpit.db
MP_SMTP_AUTH_ACCEPT_ANY=1
MP_SMTP_AUTH_ALLOW_INSECURE=1

# ── JWT ──
JWT_KEY=UltraMegaSuperSecretKeyThatYouDontKnowThisKeyOnlyForMeChumbaAndTheyAreVeryVeryLongButIsItNotEnoughItShouldBeMoreLonger
JWT_ISSUER=MyFavouriteApp
JWT_AUDIENCE=MyFavouriteAudience

# ── Notification ──
NOTIFICATION_NAME=UserService
NOTIFICATION_EMAIL=UserService@gmail.com
NOTIFICATION_PASSWORD=UserServicePassword

# ── Build ──
BUILD_TARGET=development
ASPNETCORE_ENVIRONMENT=Development
